{
  "name": "@destiny/fortune-engine",
  "version": "1.0.0",
  "description": "传统易经八字算命引擎 - 精准的四柱排盘和命理分析",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepublishOnly": "npm run build",
    "example:bazi": "npm run build && node test-example.ts",
    "example:meihua": "npm run build && node meihua-example.ts",
    "example:llm": "npm run build && node llm-example.ts",
    "serve": "node serve.js"
  },
  "keywords": [
    "bazi",
    "八字",
    "易经",
    "yijing",
    "fortune",
    "astrology",
    "chinese-calendar"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "dayjs": "^1.11.10"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.1",
    "rollup": "^4.54.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/DestinyOfANobody.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/DestinyOfANobody/issues"
  },
  "homepage": "https://github.com/your-org/DestinyOfANobody#readme"
}
